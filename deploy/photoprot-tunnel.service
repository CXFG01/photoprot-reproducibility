[Unit]
Description=PhotoProt named Cloudflare Tunnel
After=network-online.target photoprot-api.service
Wants=network-online.target photoprot-api.service

[Service]
Type=simple
User=shadeform
ExecStart=/home/shadeform/photoprot/webapp/bin/cloudflared tunnel --no-autoupdate run --token-file /home/shadeform/.cloudflared/photoprot-token
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
InaccessiblePaths=-/home/shadeform/.ssh
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
UMask=0077
MemoryMax=512M
TasksMax=64
CPUQuota=100%
LimitNOFILE=4096
LogRateLimitIntervalSec=30s
LogRateLimitBurst=100

[Install]
WantedBy=multi-user.target
